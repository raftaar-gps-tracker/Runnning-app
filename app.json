{
  "expo": {
    "name": "Raftaar",
    "owner": "raftaar-gps-trackers-team",
    "slug": "raftaar-",
    "version": "1.0.0",
    "extra": {
      "eas": {
        "projectId": "70bf787f-6be1-451e-b2bd-e57499ae8d8b"
      }
    },
    "orientation": "portrait",
    "icon": "./icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.raftaar.gpstracker",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDbQS5NKULHYSuU77bx3bjLEeNliZhgRdc"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "READ_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    }
  }
}

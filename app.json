{
  "expo": {
    "name": "Raftaar",
    "slug": "raftaar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#091016"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#091016"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "WAKE_LOCK",
        "READ_EXTERNAL_STORAGE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.raftaar.tracker"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Raftaar to use your location."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow Raftaar to access your microphone."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "70bf787f-6be1-451e-b2bd-e57499ae8d8b"
      }
    },
    "owner": "raftaar-gps-trackers-team"
  }
}
